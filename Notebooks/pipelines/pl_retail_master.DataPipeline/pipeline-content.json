{
  "properties": {
    "activities": [
      {
        "type": "Lookup",
        "typeProperties": {
          "source": {
            "type": "JsonSource",
            "formatSettings": {
              "type": "JsonReadSettings"
            },
            "storeSettings": {
              "type": "LakehouseReadSettings",
              "recursive": true,
              "enablePartitionDiscovery": false
            }
          },
          "datasetSettings": {
            "type": "Json",
            "typeProperties": {
              "location": {
                "type": "LakehouseLocation",
                "folderPath": "config",
                "fileName": "dims.json"
              }
            },
            "schema": {},
            "linkedService": {
              "name": "lh_retail",
              "properties": {
                "type": "Lakehouse",
                "typeProperties": {
                  "artifactId": "fef7e4c7-7dde-bf5a-4e0b-10abc2a006f7",
                  "workspaceId": "00000000-0000-0000-0000-000000000000",
                  "rootFolder": "Files"
                },
                "annotations": []
              }
            },
            "annotations": []
          },
          "firstRowOnly": false
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Lookup_DimList",
        "dependsOn": []
      },
      {
        "type": "ForEach",
        "typeProperties": {
          "isSequential": true,
          "items": {
            "value": "@activity('Lookup_DimList').output.value",
            "type": "Expression"
          },
          "activities": [
            {
              "type": "TridentNotebook",
              "typeProperties": {
                "notebookId": "368c4e97-38ac-865a-4eda-62672c424d1e",
                "workspaceId": "00000000-0000-0000-0000-000000000000",
                "parameters": {
                  "DimName": {
                    "value": {
                      "value": "@item().name",
                      "type": "Expression"
                    },
                    "type": "string"
                  }
                }
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "load_dim",
              "dependsOn": []
            }
          ]
        },
        "name": "FE_Dims",
        "dependsOn": [
          {
            "activity": "Lookup_DimList",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "TridentNotebook",
        "typeProperties": {
          "notebookId": "a669abe1-b80c-a6ff-4051-191b3638d453",
          "workspaceId": "00000000-0000-0000-0000-000000000000",
          "parameters": {
            "run_date": {
              "value": {
                "value": "@formatDateTime(utcNow(),'yyyy-MM-dd')",
                "type": "Expression"
              },
              "type": "string"
            }
          }
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "Run_Bronze_to_Silver",
        "dependsOn": [
          {
            "activity": "FE_Dims",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "Lookup",
        "typeProperties": {
          "source": {
            "type": "LakehouseTableSource"
          },
          "datasetSettings": {
            "type": "LakehouseTable",
            "typeProperties": {
              "schema": "dbo",
              "table": "silver_sales"
            },
            "schema": [],
            "linkedService": {
              "name": "lh_retail",
              "properties": {
                "type": "Lakehouse",
                "typeProperties": {
                  "artifactId": "fef7e4c7-7dde-bf5a-4e0b-10abc2a006f7",
                  "workspaceId": "00000000-0000-0000-0000-000000000000",
                  "rootFolder": "Tables"
                },
                "annotations": []
              }
            },
            "annotations": []
          }
        },
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureInput": false,
          "secureOutput": false
        },
        "name": "silver_count",
        "dependsOn": [
          {
            "activity": "Run_Bronze_to_Silver",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "IfCondition",
        "typeProperties": {
          "expression": {
            "value": "@greater(int(activity('silver_count').output.firstRow.product_id), 0)",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "type": "TridentNotebook",
              "typeProperties": {
                "notebookId": "68d864fe-37f3-819e-4f77-0204bf9397a1",
                "workspaceId": "00000000-0000-0000-0000-000000000000"
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 2,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "silver_to_gold",
              "dependsOn": []
            },
            {
              "type": "Office365Email",
              "typeProperties": {
                "to": "amit@yahoo.com",
                "subject": {
                  "value": "@concat('RetailCo pipeline Successfull:- silver row count' ,variables('silverRows'))",
                  "type": "Expression"
                }
              },
              "externalReferences": {
                "connection": "this is dynamic"
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "Office365Email2",
              "dependsOn": [
                {
                  "activity": "silver_to_gold",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ]
            }
          ],
          "ifFalseActivities": [
            {
              "type": "Office365Email",
              "typeProperties": {
                "body": "<p>@{pipeline().DataFactory}</p>",
                "to": "hello@todo.com",
                "subject": {
                  "value": "@concat('RetailCo pipeline FAILED: ', pipeline().RunId)",
                  "type": "Expression"
                }
              },
              "externalReferences": {
                "connection": "this is dynamic"
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "Office365Email1",
              "dependsOn": []
            }
          ]
        },
        "name": "validate_silver_count",
        "dependsOn": [
          {
            "activity": "silver_count",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "SetVariable",
        "typeProperties": {
          "variableName": "silverRows",
          "value": {
            "value": "@activity('silver_count').output",
            "type": "Expression"
          }
        },
        "policy": {
          "secureInput": false,
          "secureOutput": false
        },
        "name": "silver_row_count",
        "dependsOn": [
          {
            "activity": "silver_count",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      }
    ],
    "variables": {
      "silverRows": {
        "type": "String"
      }
    },
    "concurrency": 1
  }
}